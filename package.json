{
  "name": "synnera-pwa",
  "version": "2.16.36",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:gst": "tsc -p tsconfig.tax-test.json && node /tmp/tax-out/gstCalculator.test.js",
    "test:invoice": "npx tsx src/modules/invoicing/invoiceDomain.real.test.ts",
    "test:ledger": "npx tsx src/modules/financial/ledger/ledgerLogic.test.ts",
    "test:payments": "npx tsx src/modules/financial/payments/paymentLogic.test.ts",
    "test:statements": "npx tsx src/modules/financial/statements/statementLogic.test.ts",
    "test:outstanding": "npx tsx src/modules/financial/outstanding/outstandingLogic.test.ts",
    "test:collections": "npx tsx src/modules/financial/reports/collectionLogic.test.ts",
    "test:messages": "npx tsx src/modules/financial/communication/messageGenerator.test.ts",
    "test:permissions": "npx tsx src/modules/financial/ledger/ledgerPermissions.test.ts",
    "test:retail": "npx tsx src/modules/sales/retailOrderRules.test.ts",
    "test:financial": "npx tsx src/modules/financial/ledger/ledgerLogic.test.ts && npx tsx src/modules/financial/payments/paymentLogic.test.ts && npx tsx src/modules/financial/statements/statementLogic.test.ts && npx tsx src/modules/financial/outstanding/outstandingLogic.test.ts && npx tsx src/modules/financial/reports/collectionLogic.test.ts && npx tsx src/modules/financial/communication/messageGenerator.test.ts && npx tsx src/modules/financial/ledger/ledgerPermissions.test.ts && npx tsx src/modules/financial/financialIsolation.test.ts",
    "test:isolation": "npx tsx src/modules/financial/financialIsolation.test.ts",
    "build:functions": "npm --prefix functions run build",
    "deploy:functions": "npm --prefix functions run deploy",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@imagekit/next": "2.1.5",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^10.12.4",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.414.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8",
    "pdfjs-dist": "4.8.69"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3"
  },
  "deploy:functions": "npm --prefix functions run deploy"
}
